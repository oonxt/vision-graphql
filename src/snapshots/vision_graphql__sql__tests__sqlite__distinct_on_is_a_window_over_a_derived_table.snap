---
source: src/sql.rs
expression: sql
---
SELECT json_object('posts', (SELECT json_group_array(json_object('user_id', r1."user_id", 'title', r1."title", 'published', CASE r1."published" WHEN 1 THEN json('true') WHEN 0 THEN json('false') END)) FROM (SELECT t0."user_id" AS "user_id", t0."title" AS "title", t0."published" AS "published" FROM (SELECT t0.*, row_number() OVER (PARTITION BY t0."user_id" ORDER BY t0."user_id" ASC NULLS LAST, t0."views" DESC NULLS FIRST) AS "__vision_graphql_rn" FROM "main"."posts" t0 WHERE t0."views" > ?1) t0 WHERE t0."__vision_graphql_rn" = 1 ORDER BY t0."user_id" ASC NULLS LAST, t0."views" DESC NULLS FIRST LIMIT 5) r1)) AS result
