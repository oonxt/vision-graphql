UPDATE "main"."users" SET "name" = ?1 WHERE ("active" = ?2 AND "id" = ?3) RETURNING json_object('__rowid', rowid, 'id', "id", 'name', "name", 'active', CASE WHEN "active" IS NULL THEN NULL WHEN "active" = 1 THEN json('true') WHEN "active" = 0 THEN json('false') ELSE json('not a boolean') END, 'meta', json("meta"))
SELECT count(*) FROM "main"."users" t WHERE t.rowid IN (SELECT value FROM json_each(?1)) AND NOT (t."id" = ?2)
DELETE FROM "main"."posts" WHERE ("id" = ?1 AND TRUE) RETURNING json_object('__rowid', rowid, 'id', "id", 'user_id', "user_id", 'title', "title")
SELECT json_group_array(json_object('name', t0."name")) FROM (SELECT x.* FROM "main"."users" x JOIN json_each(?1) je ON x.rowid = je.value ORDER BY je.key) t0
