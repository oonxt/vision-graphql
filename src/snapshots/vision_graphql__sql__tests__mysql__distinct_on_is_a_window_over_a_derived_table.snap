SELECT JSON_OBJECT('posts', COALESCE((SELECT JSON_ARRAYAGG(JSON_OBJECT('user_id', r1.`user_id`, 'title', r1.`title`, 'published', CASE WHEN r1.`published` IS NULL THEN NULL WHEN r1.`published` THEN CAST('true' AS JSON) ELSE CAST('false' AS JSON) END)) OVER (ORDER BY r1.__vision_graphql_ord ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING) FROM (SELECT t0.`user_id` AS `user_id`, t0.`title` AS `title`, t0.`published` AS `published`, ROW_NUMBER() OVER (ORDER BY t0.`user_id` IS NULL ASC, t0.`user_id` ASC, t0.`views` IS NULL ASC, t0.`views` DESC) AS __vision_graphql_ord FROM (SELECT t0.*, row_number() OVER (PARTITION BY t0.`user_id` ORDER BY t0.`user_id` IS NULL ASC, t0.`user_id` ASC, t0.`views` IS NULL ASC, t0.`views` DESC) AS __vision_graphql_rn FROM `app`.`posts` t0 WHERE t0.`views` > ?) t0 WHERE t0.__vision_graphql_rn = 1 ORDER BY t0.`user_id` IS NULL ASC, t0.`user_id` ASC, t0.`views` IS NULL ASC, t0.`views` DESC LIMIT 5) r1 LIMIT 1), JSON_ARRAY())) AS result
