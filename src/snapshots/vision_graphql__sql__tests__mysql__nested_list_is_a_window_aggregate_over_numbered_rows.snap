SELECT JSON_OBJECT('users', COALESCE((SELECT JSON_ARRAYAGG(JSON_OBJECT('id', r1.`id`, 'name', r1.`name`, 'active', CASE WHEN r1.`active` IS NULL THEN NULL WHEN r1.`active` THEN CAST('true' AS JSON) ELSE CAST('false' AS JSON) END, 'meta', r1.`meta`, 'score', r1.`score`, 'created_at', CASE WHEN r1.`created_at` IS NULL THEN NULL ELSE CONCAT(DATE_FORMAT(r1.`created_at`, '%Y-%m-%dT%H:%i:%s'), IF(MICROSECOND(r1.`created_at`) = 0, '', CONCAT('.', TRIM(TRAILING '0' FROM DATE_FORMAT(r1.`created_at`, '%f')))), '') END, 'seen_at', CASE WHEN r1.`seen_at` IS NULL THEN NULL ELSE CONCAT(DATE_FORMAT(CONVERT_TZ(r1.`seen_at`, @@session.time_zone, '+00:00'), '%Y-%m-%dT%H:%i:%s'), IF(MICROSECOND(CONVERT_TZ(r1.`seen_at`, @@session.time_zone, '+00:00')) = 0, '', CONCAT('.', TRIM(TRAILING '0' FROM DATE_FORMAT(CONVERT_TZ(r1.`seen_at`, @@session.time_zone, '+00:00'), '%f')))), '+00:00') END, 'first', r1.`first`, 'posts', r1.`posts`)) OVER (ORDER BY r1.__vision_graphql_ord ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING) FROM (SELECT t0.`id` AS `id`, t0.`name` AS `name`, t0.`active` AS `active`, t0.`meta` AS `meta`, t0.`score` AS `score`, t0.`created_at` AS `created_at`, t0.`seen_at` AS `seen_at`, JSON_EXTRACT(t0.`meta`, ?) AS `first`, COALESCE((SELECT JSON_ARRAYAGG(JSON_OBJECT('title', r3.`title`, 'published', CASE WHEN r3.`published` IS NULL THEN NULL WHEN r3.`published` THEN CAST('true' AS JSON) ELSE CAST('false' AS JSON) END, 'user', r3.`user`)) OVER (ORDER BY r3.__vision_graphql_ord ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING) FROM (SELECT t2.`title` AS `title`, t2.`published` AS `published`, (SELECT JSON_OBJECT('name', r5.`name`) FROM (SELECT t4.`name` AS `name` FROM `app`.`users` t4 WHERE t4.`id` = t2.`user_id` LIMIT 1) r5) AS `user`, ROW_NUMBER() OVER (ORDER BY t2.`title` IS NULL DESC, t2.`title` DESC) AS __vision_graphql_ord FROM `app`.`posts` t2 WHERE t2.`user_id` = t0.`id` ORDER BY t2.`title` IS NULL DESC, t2.`title` DESC LIMIT 3) r3 LIMIT 1), JSON_ARRAY()) AS `posts`, ROW_NUMBER() OVER (ORDER BY t0.`score` IS NULL ASC, t0.`score` ASC) AS __vision_graphql_ord FROM `app`.`users` t0 WHERE (t0.`id` IN (SELECT jt.v FROM JSON_TABLE(?, '$[*]' COLUMNS (v BIGINT PATH '$')) AS jt) AND LOWER(t0.`name`) LIKE LOWER(?) AND (CAST(? AS DECIMAL(65,30)) IS NULL OR t0.`score` >= CAST(? AS DECIMAL(65,30)))) ORDER BY t0.`score` IS NULL ASC, t0.`score` ASC LIMIT 18446744073709551615 OFFSET 2) r1 LIMIT 1), JSON_ARRAY())) AS result
