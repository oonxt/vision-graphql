---
source: src/sql.rs
expression: sql
---
SELECT json_object('users', (SELECT json_group_array(json_object('id', r1."id", 'name', r1."name", 'active', CASE WHEN r1."active" IS NULL THEN NULL WHEN r1."active" = 1 THEN json('true') WHEN r1."active" = 0 THEN json('false') ELSE json('not a boolean') END, 'meta', json(r1."meta"), 'first', json(r1."first"), 'posts', json(r1."posts"))) FROM (SELECT t0."id" AS "id", t0."name" AS "name", t0."active" AS "active", t0."meta" AS "meta", t0."meta" -> ?1 AS "first", (SELECT json_group_array(json_object('title', r3."title", 'published', CASE WHEN r3."published" IS NULL THEN NULL WHEN r3."published" = 1 THEN json('true') WHEN r3."published" = 0 THEN json('false') ELSE json('not a boolean') END, 'user', json(r3."user"))) FROM (SELECT t2."title" AS "title", t2."published" AS "published", (SELECT json_object('name', r5."name") FROM (SELECT t4."name" AS "name" FROM "main"."users" t4 WHERE t4."id" = t2."user_id" LIMIT 1) r5) AS "user" FROM (SELECT t2."title", t2."published", t2."user_id" FROM "main"."posts" t2 WHERE t2."user_id" = t0."id" ORDER BY t2."title" DESC NULLS FIRST LIMIT 3) t2 ORDER BY t2."title" DESC NULLS FIRST) r3) AS "posts" FROM (SELECT t0."id", t0."name", t0."active", t0."meta", t0."score" FROM "main"."users" t0 WHERE (t0."id" IN (SELECT value FROM json_each(?2)) AND lower(t0."name") LIKE lower(?3) ESCAPE '\') ORDER BY t0."score" ASC NULLS LAST LIMIT -1 OFFSET 2) t0 ORDER BY t0."score" ASC NULLS LAST) r1)) AS result
