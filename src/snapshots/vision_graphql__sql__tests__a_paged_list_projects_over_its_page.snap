---
source: src/sql.rs
expression: sql
---
SELECT json_build_object('users', (SELECT coalesce(json_agg(row_to_json(r1)), '[]'::json) FROM (SELECT t0."id" AS "id", (SELECT coalesce(json_agg(row_to_json(r3)), '[]'::json) FROM (SELECT t2."title" AS "title" FROM "public"."posts" t2 WHERE t2."user_id" = t0."id") r3) AS "posts" FROM (SELECT t0.* FROM "public"."users" t0 ORDER BY t0."name" ASC LIMIT 50 OFFSET 5000) t0 ORDER BY t0."name" ASC) r1)) AS result
