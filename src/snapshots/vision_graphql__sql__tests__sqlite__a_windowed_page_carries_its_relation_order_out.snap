---
source: src/sql.rs
expression: sql
---
SELECT json_object('posts', (SELECT json_group_array(json_object('title', r1."title")) FROM (SELECT t0."title" AS "title" FROM (SELECT t0."title", t0."user_id", t0.__vision_graphql_ob1 FROM (SELECT t0."title", t0."user_id", ob2."name" AS __vision_graphql_ob1, row_number() OVER (PARTITION BY t0."user_id" ORDER BY t0."user_id" ASC NULLS LAST, ob2."name" DESC NULLS FIRST) AS __vision_graphql_rn FROM "main"."posts" t0 LEFT JOIN "main"."users" AS ob2 ON ob2."id" = t0."user_id" WHERE t0."views" > ?1) t0 WHERE t0.__vision_graphql_rn = 1 ORDER BY t0."user_id" ASC NULLS LAST, t0.__vision_graphql_ob1 DESC NULLS FIRST LIMIT 2 OFFSET 1) t0 ORDER BY t0."user_id" ASC NULLS LAST, t0.__vision_graphql_ob1 DESC NULLS FIRST) r1)) AS result
