---
source: src/sql.rs
expression: sql
---
SELECT json_object('users_by_pk', (SELECT json_object('__typename', r1."__typename", 'name', r1."name", 'active', CASE r1."active" WHEN 1 THEN json('true') WHEN 0 THEN json('false') END) FROM (SELECT 'users' AS "__typename", t0."name" AS "name", t0."active" AS "active" FROM "main"."users" t0 WHERE t0."id" = ?1 LIMIT 1) r1)) AS result
