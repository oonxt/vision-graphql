SELECT JSON_OBJECT('users_by_pk', (SELECT JSON_OBJECT('__typename', r1.`__typename`, 'name', r1.`name`, 'active', CASE WHEN r1.`active` IS NULL THEN NULL WHEN r1.`active` THEN CAST('true' AS JSON) ELSE CAST('false' AS JSON) END) FROM (SELECT 'users' AS `__typename`, t0.`name` AS `name`, t0.`active` AS `active` FROM `app`.`users` t0 WHERE t0.`id` = ? LIMIT 1) r1), 'keyed', COALESCE((SELECT JSON_ARRAYAGG(JSON_OBJECT('id', r3.`id`)) OVER (ORDER BY r3.__vision_graphql_ord ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING) FROM (SELECT t2.`id` AS `id`, ROW_NUMBER() OVER () AS __vision_graphql_ord FROM `app`.`users` t2 WHERE (CASE WHEN t2.`meta` IS NULL THEN NULL WHEN JSON_TYPE(t2.`meta`) = 'OBJECT' THEN JSON_CONTAINS_PATH(t2.`meta`, 'one', CONCAT('$.', JSON_QUOTE(?))) WHEN JSON_TYPE(t2.`meta`) = 'ARRAY' THEN (? MEMBER OF(t2.`meta`)) WHEN JSON_TYPE(t2.`meta`) = 'STRING' THEN JSON_UNQUOTE(t2.`meta`) = ? ELSE FALSE END AND JSON_CONTAINS(t2.`meta`, CAST(? AS JSON)) AND CASE WHEN t2.`meta` IS NULL THEN NULL WHEN JSON_TYPE(t2.`meta`) = 'OBJECT' THEN JSON_OVERLAPS(JSON_KEYS(t2.`meta`), CAST(? AS JSON)) WHEN JSON_TYPE(t2.`meta`) = 'ARRAY' THEN JSON_OVERLAPS(t2.`meta`, CAST(? AS JSON)) WHEN JSON_TYPE(t2.`meta`) = 'STRING' THEN JSON_CONTAINS(CAST(? AS JSON), t2.`meta`) ELSE FALSE END)) r3 LIMIT 1), JSON_ARRAY())) AS result
